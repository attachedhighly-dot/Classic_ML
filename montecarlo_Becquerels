Becquerels

import numpy as np

# 1. Input Parameters (Example: Short-lived Isotope or small sample)
# To prevent memory issues or long loops, Monte Carlo simulates a countable number of atoms
N0 = 1_000_000         # Initial number of radioactive atoms
half_life_seconds = 10.0  # Short half-life in seconds (for demonstration)

# 2. Calculate Probability of Decay per Second
# Probability (p) that a single nucleus decays in exactly 1 second
lam = np.log(2) / half_life_seconds
p_decay_per_second = 1.0 - np.exp(-lam * 1.0)

# 3. Setup Simulation Parameters
total_seconds = 40     # Duration of the simulation
N_remaining = N0       # Tracks atoms left at each step

# Arrays to store history
time_steps = np.arange(total_seconds)
simulated_activity_bq = np.zeros(total_seconds)
theoretical_activity_bq = np.zeros(total_seconds)

# 4. Run the Monte Carlo Simulation Step-by-Step
for t in range(total_seconds):
    # Theoretical Activity: A = lambda * N_remaining (expected average value)
    theoretical_activity_bq[t] = lam * N_remaining
    
    if N_remaining > 0:
        # NumPy binomial distribution: Flip a biased coin for all remaining atoms at once
        # N_remaining = number of trials, p_decay_per_second = success probability
        decays_this_second = np.random.binomial(N_remaining, p_decay_per_second)
    else:
        decays_this_second = 0
        
    # The number of decays occurring in this 1-second window IS the activity in Bq
    simulated_activity_bq[t] = decays_this_second
    
    # Update inventory for the next second
    N_remaining -= decays_this_second

# 5. Print Sample Results
print(f"{'Time (s)':<10}{'Simulated Activity (Bq)':<25}{'Theoretical Activity (Bq)':<25}")
for t in:
    print(f"{t:<10}{simulated_activity_bq[t]:<25.0f}{theoretical_activity_bq[t]:<25.2f}")
